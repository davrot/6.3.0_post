extends ../../../../app/views/layout-react

//- 2026-09-04 (R5#2, owner round-5) — STRUCTURAL REBUILD on the EXACT
//- /admin/site golden DOM (same as /user/mysettings, blue user family):
//- layout navbar suppressed — the PAGE renders its own shared React navbar
//- (DefaultNavbar INSIDE .user-ds-nav-page; the shared DS-nav CSS only
//-  applies inside that div);
//- .user-list-sidebar-wrapper-react COLUMN wrapper around the sidebar
//-  (left column with the section links the user asked for);
//- the SHARED React account menu (email, Theme toggle, Log out) in
//-  .ds-nav-sidebar-lower — the previous in-page DsPageAccountMenu render
//-  was "not functional" (round-4/5) and the custom 220px column was not
//-  the golden left column;
//- theme-aware: the shared chrome follows ace.overallTheme (dark/light)
//-  exactly like /admin/site — the hardcoded white cards that made this
//-  page "not theme aware" are gone (content surfaces via .user-ds-nav-* /
//-  .page-content-card tokens).
//- The React app entry (modules/llm/pages/user/llm-settings) is unchanged —
//- it now renders CONTENT ONLY (the section cards) into #settings-page-root.

block entrypointVar
	- entrypoint = 'modules/llm/pages/user/llm-settings'

block vars
	- const hideNavLogo = true
	// 2026-09 (Q, owner): no 'Overleaf Community Edition' brand title.
	- const hideBrandTitle = true
	- const bodyDataPage = 'llm-settings'
	- isWebsiteRedesign = true
	// Golden parity: this page renders its own chrome within the DS-nav page.
	- const suppressNavContentLinks = true
	- const suppressNavbar = true
	- const suppressFooter = true
	- const suppressPugCookieBanner = true
	// 2026-09 (owner): user settings pages use the BLUE gradient nav.
	- const blueNav = true
	- const showThinFooter = false

block append meta
	// Theme machinery from the gold /admin/site pattern (user-my-settings.pug):
	// the page follows ace.overallTheme (dark/light/system).
	meta(name='ol-adminOverallTheme' content=(user && user.ace && user.ace.overallTheme) || '')
	meta(name='ol-userSettings' data-type='json' content=userSettings)
	meta(name='ol-overallThemes' data-type='json' content=overallThemes)

	script(type="text/javascript" nonce=scriptNonce).
		(function () {
		function apply() {
		try {
		var el = document.querySelector('meta[name=ol-adminOverallTheme]');
		if (!el) return;
		var v = el.getAttribute('content') || '';
		var prefersDark = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
		var dark = v === 'system' ? prefersDark : v !== 'light-';
		document.body.dataset.theme = dark ? 'default' : 'light';
		} catch (e) {}
		}
		if (document.body) apply();
		else document.addEventListener('DOMContentLoaded', apply);
		})();
	meta(name='ol-user' data-type='json' content=user)
	meta(name='ol-featureChatEnabled' data-type='json' content=JSON.stringify(featureFlags.chatEnabled))
	meta(name='ol-featureCompletionEnabled' data-type='json' content=JSON.stringify(featureFlags.completionEnabled))
	//- R5#2: shell config consumed by page-shells/pages/ds-settings-shell.
	meta(name='ol-dsSettingsShell' data-type='json' content=JSON.stringify({
		navbarRootId: 'llm-settings-navbar-root',
		accountRootId: 'llm-settings-account-root',
		cookieRootId: 'llm-settings-cookie-root'
	}))

	script(type="text/javascript" nonce=scriptNonce).
		window.__dsSettingsShell = {
		navbarRootId: 'llm-settings-navbar-root',
		accountRootId: 'llm-settings-account-root',
		cookieRootId: 'llm-settings-cookie-root',
		};

block content
	ol-admin-shell-marker(style='display:none' data-shell='llm-settings')
	.user-ds-nav-page.website-redesign.manage-extensions-page
		#llm-settings-navbar-root
		.user-list-wrapper
			.user-list-sidebar-wrapper-react.d-none.d-md-flex.manage-extensions-sidebar
				nav.flex-grow.flex-shrink(role='navigation' aria-label='LLM settings sections')
					.user-list-sidebar-scroll
						ul.list-unstyled.user-list-filters
							li.dropdown-header AI settings
							li.ds-nav-page-nav-item
								button(type='button' data-target='#llm-user-general') LLM settings
							li.ds-nav-page-nav-item
								button(type='button' data-target='#llm-user-grammar') Grammar checking
							li.ds-nav-page-nav-item
								button(type='button' data-target='#llm-user-compliance') Compliance review
							li.ds-nav-page-nav-item
								button(type='button' data-target='#llm-user-usage') Usage
				.ds-nav-sidebar-lower
					nav.d-flex.flex-row.gap-3.mb-2(aria-label='Account and help')
						#llm-settings-account-root
			.user-ds-nav-content-and-messages
				.user-ds-nav-content
					.user-ds-nav-main
						main#main-content(aria-labelledby='main-content')
							#settings-page-root
				#llm-settings-cookie-root

	each file in entrypointScripts('modules/page-shells/pages/ds-settings-shell')
		script(type='text/javascript' nonce=scriptNonce src=file)
