extends ../../../../app/views/layout-react.pug
//- 2026-09-04 (R5#4, owner round-5) — STRUCTURAL REBUILD on the EXACT
//- /admin/site golden DOM (red admin family, same shell as /admin/panel):
//- page renders its own shared React navbar INSIDE .user-ds-nav-page;
//- the golden LEFT COLUMN (.user-list-sidebar-wrapper-react) with the
//- section links (Features / API Connection / Models / System Prompt /
//-  AI Prompts / Availability / Usage);
//- the SHARED React account menu in .ds-nav-sidebar-lower — the previous
//- in-page one was "not functional" (round-4/5);
//- theme-aware dark/light via the shared chrome (ace.overallTheme) —
//- was not theme-aware with the white custom layout;
//- the React app (modules/llm/pages/admin/llm-admin-settings) now renders
//- CONTENT ONLY (the numbered section cards) into #llm-admin-settings-root,
//- all sections stacked + scrolled (the old tab hide/show CSS is retired).

block entrypointVar
    - entrypoint = 'modules/llm/pages/admin/llm-admin-settings'

block vars
    - const hideNavLogo = true
    // 2026-09 (Q, owner): no brand title.
    - const hideBrandTitle = true
    - const bodyDataPage = 'llm-admin'
    - isWebsiteRedesign = true
    // 2026-09 (owner): join the red admin page family (gold: /admin/site).
    - const redNav = true
    // 2026-09 (O, owner): NO footer at all on this page — only "/" keeps one.
    - const showThinFooter = false
    - const suppressFooter = true
    // Golden parity: this page renders its own chrome within the DS-nav page.
    - const suppressNavContentLinks = true
    - const suppressNavbar = true
    - const suppressPugCookieBanner = true

block append meta
    // Theme machinery from the gold /admin/site pattern: the page follows
    // ace.overallTheme (dark/light/system) via the shared chrome.
    meta(name='ol-adminOverallTheme' content=(user && user.ace && user.ace.overallTheme) || '')
    meta(name='ol-userSettings' data-type='json' content=userSettings)
    meta(name='ol-overallThemes' data-type='json' content=overallThemes)

    script(type="text/javascript" nonce=scriptNonce).
        (function () {
        function apply() {
        try {
        var el = document.querySelector('meta[name=ol-adminOverallTheme]');
        if (!el) return;
        var v = el.getAttribute('content') || '';
        var prefersDark = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var dark = v === 'system' ? prefersDark : v !== 'light-';
        document.body.dataset.theme = dark ? 'default' : 'light';
        } catch (e) {}
        }
        if (document.body) apply();
        else document.addEventListener('DOMContentLoaded', apply);
        })();
    meta(name='ol-systemPrompt' data-type='string' content=systemPrompt)
    meta(name='ol-llmApiUrl' data-type='string' content=llmApiUrl)
    meta(name='ol-llmApiType' data-type='string' content=llmApiType)
    meta(name='ol-hasLlmApiKey' data-type='string' content=hasLlmApiKey ? 'true' : 'false')
    meta(name='ol-allowedModels' data-type='string' content=(allowedModels || []).join(','))
    //- overleaf-lab (grammar port): global force-off + LanguageTool service
    meta(name='ol-llmDisabledByAdmin' data-type='string' content=llmDisabledByAdmin ? 'true' : 'false')
    meta(name='ol-languageToolUrl' data-type='string' content=languageToolUrl)
    meta(name='ol-languageToolDisabledByAdmin' data-type='string' content=languageToolDisabledByAdmin ? 'true' : 'false')
    meta(name='ol-knownModels' data-type='string' content=(knownModels || []).join(','))
    meta(name='ol-completionModel' data-type='string' content=completionModel)
    meta(name='ol-llmApiUrlFromEnv' data-type='string' content=llmApiUrlFromEnv ? 'true' : 'false')
    meta(name='ol-llmApiTypeFromEnv' data-type='string' content=llmApiTypeFromEnv ? 'true' : 'false')
    meta(name='ol-complianceRubrics' data-type='json' content=JSON.stringify(complianceRubrics || []))
    meta(name='ol-reviewModel' data-type='string' content=reviewModel)
    meta(name='ol-maxContextTokens' data-type='string' content=String(maxContextTokens))
    meta(name='ol-reviewMaxTokens' data-type='string' content=String(reviewMaxTokens))
    //- overleaf-lab: per-feature enable/disable toggles (default true)
    meta(name='ol-chatEnabled' data-type='json' content=JSON.stringify(chatEnabled))
    meta(name='ol-completionEnabled' data-type='json' content=JSON.stringify(completionEnabled))
    meta(name='ol-reviewEnabled' data-type='json' content=JSON.stringify(reviewEnabled))
    //- overleaf-lab: editable AI prompts and their built-in defaults for reset buttons
    meta(name='ol-askAiSystemPrompt' data-type='string' content=askAiSystemPrompt)
    meta(name='ol-errorPrompt' data-type='string' content=errorPrompt)
    meta(name='ol-reviewSystemPrompt' data-type='string' content=reviewSystemPrompt)
    meta(name='ol-askAiActionPrompts' data-type='json' content=JSON.stringify(askAiActionPrompts || {}))
    meta(name='ol-promptDefaults' data-type='json' content=JSON.stringify(promptDefaults || {}))
    //- R5#4: shell config consumed by page-shells/pages/ds-settings-shell.
    meta(name='ol-dsSettingsShell' data-type='json' content=JSON.stringify({
        navbarRootId: 'llm-admin-navbar-root',
        accountRootId: 'llm-admin-account-root',
        cookieRootId: 'llm-admin-cookie-root'
    }))

    script(type="text/javascript" nonce=scriptNonce).
        window.__dsSettingsShell = {
        navbarRootId: 'llm-admin-navbar-root',
        accountRootId: 'llm-admin-account-root',
        cookieRootId: 'llm-admin-cookie-root',
        };

block content
    ol-admin-shell-marker(style='display:none' data-shell='llm-admin')
    .user-ds-nav-page.website-redesign.red-nav-bar-for-admins.manage-extensions-page
        #llm-admin-navbar-root
        .user-list-wrapper
            .user-list-sidebar-wrapper-react.d-none.d-md-flex.manage-extensions-sidebar
                nav.flex-grow.flex-shrink(role='navigation' aria-label='LLM settings sections')
                    .user-list-sidebar-scroll
                        ul.list-unstyled.user-list-filters
                            li.dropdown-header LLM configuration
                            li.ds-nav-page-nav-item
                                button(type='button' data-sec='features') Features
                            li.ds-nav-page-nav-item
                                button(type='button' data-sec='connection') API connection
                            li.ds-nav-page-nav-item
                                button(type='button' data-sec='models') Model selection
                            li.ds-nav-page-nav-item
                                button(type='button' data-sec='prompt') System prompt
                            li.ds-nav-page-nav-item
                                button(type='button' data-sec='prompts') AI prompts
                            li.ds-nav-page-nav-item
                                button(type='button' data-sec='availability') Services (availability)
                            li.ds-nav-page-nav-item
                                button(type='button' data-sec='usage') Usage
                .ds-nav-sidebar-lower
                    nav.d-flex.flex-row.gap-3.mb-2(aria-label='Account and help')
                        #llm-admin-account-root
            .user-ds-nav-content-and-messages
                .user-ds-nav-content
                    .user-ds-nav-main
                        main#main-content(aria-labelledby='main-content')
                            #llm-admin-settings-root
                #llm-admin-cookie-root

    each file in entrypointScripts('modules/page-shells/pages/ds-settings-shell')
        script(type='text/javascript' nonce=scriptNonce src=file)
