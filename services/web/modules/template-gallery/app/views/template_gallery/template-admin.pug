extends ../../../../../app/views/layout-react

block entrypointVar
	- entrypoint = 'modules/template-gallery/pages/template-admin'

block vars
	- const hideNavLogo = true
	- const bodyDataPage = 'templates-manage'  // 2026-09 (S1, owner): page-scoped CSS kill for marketing navbar brand
	// 2026-09 (Q, owner): no 'Overleaf Community Edition' brand title on app/admin/user pages.
	- const hideBrandTitle = true
	- const suppressFooter = true
	- const suppressPugCookieBanner = true
	- isWebsiteRedesign = true
	// 2026-09 (owner C/I): gold-family parity — red admin gradient, no footer.
	- const redNav = true
	- const showThinFooter = false

block append meta
	if typeof userSettings !== 'undefined' && userSettings
		meta(name="ol-userSettings" data-type="json" content=userSettings)
	meta(name="ol-overallThemes" data-type="json" content=overallThemes)
	meta(name="ol-userIsTemplatesManager" data-type="boolean" content=(typeof userIsTemplatesManager !== 'undefined' && userIsTemplatesManager))

block content
	#template-admin-root
