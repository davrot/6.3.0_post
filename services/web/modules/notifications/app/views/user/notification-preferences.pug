extends ../../../../../app/views/layout-react

block entrypointVar
	- entrypoint = 'pages/user/notification-prefs'

block vars
	- const hideNavLogo = true
	- isWebsiteRedesign = true
	// 2026-09 (S, owner): join the user-settings family (/user/mysettings family)
	// — blue gradient nav, no brand title, no footer, theme-aware. Was on the
	// marketing website-redesign layout (public-page look + its own footer).
	- const blueNav = true
	// 2026-09 (8, owner): hides the navbar Account pill on this page — the user
	// menu moves to the down-left sidebar slot (.ds-nav-sidebar-lower).
	- const bodyDataPage = 'notification-prefs'
	- const hideBrandTitle = true
	- const suppressFooter = true
	- const suppressPugCookieBanner = true

block append meta
	// 2026-09 (S+P, owner): theme machinery from the gold /admin/site pattern
	// (user-my-settings.pug) — the page follows the overall theme.
	meta(name='ol-adminOverallTheme' content=(user && user.ace && user.ace.overallTheme) || '')
	meta(name='ol-userSettings' data-type='json' content=userSettings)
	meta(name='ol-overallThemes' data-type='json' content=overallThemes)

	script(type="text/javascript" nonce=scriptNonce).
		(function () {
		  function apply() {
		    try {
		      var el = document.querySelector('meta[name=ol-adminOverallTheme]');
		      if (!el) return;
		      var v = el.getAttribute('content') || '';
		      var prefersDark = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
		      var dark = v === 'system' ? prefersDark : v !== 'light-';
		      document.body.dataset.theme = dark ? 'default' : 'light';
		    } catch (e) {}
		  }
		  if (document.body) apply();
		  else document.addEventListener('DOMContentLoaded', apply);
		})();

block content
	main#main-content.content
		.container
			// 2026-09 (S+P, owner): user-settings family layout — left column
			// with the down-left SHARED account menu (.ds-nav-sidebar-lower,
			// same component as the golden /admin/site), content in gold
			// .page-content-card sections. The navbar Account pill is hidden
			// (body[data-page=notification-prefs] CSS).
			.d-flex.align-items-start.notification-prefs__layout
				nav.notification-prefs__sidebar(aria-label=translate("notification_preferences"))
					ul.list-unstyled
						li
							a(href='/user/notification-preferences') #{translate("notification_preferences")}
					#notif-prefs-account-root
				.flex-grow-1.notification-prefs__content.pl-4
					.page-header
						h1 #{translate("email_preferences")}

				form.notification-settings-container(
					name='notificationsForm'
					action='/user/notification-preferences'
					method='POST'
					data-ol-async-form
					data-ol-reload-on-success
				)
					input(name='_csrf' type='hidden' value=csrfToken)

					.card.page-content-card.setting-container.mb-4
						input(name='muteAllNotifications' id='muteAllNotifications' type='checkbox' value='notificationsOn' checked=notificationsEnabled)
						div
							label.checkbox-label(for='muteAllNotifications')
								h2.h4.mb-0 #{translate("notifications_on_project_activity")}
							p #{translate("notifications_on_project_activity_description")}

					.card.page-content-card.setting-container.mb-4
						input(name='notificationDelayMinutes' id='notificationDelayMinutes' type='number' min='1' max='10080' step='1' value=(notificationDelayMinutes != null ? notificationDelayMinutes : ''))
						div
							label.checkbox-label(for='notificationDelayMinutes')
								h2.h4.mb-0 #{translate("notifications_delay_minutes_label")}
							p #{translate("notifications_delay_description")}
							p.text-muted #{translate("notifications_delay_server_default")} #{defaultDelayLabel}

					p #{translate("note_still_receives_important_emails")}

					.d-flex.justify-content-end.mt-4
						button.btn-primary.btn(type='submit' data-ol-disabled-inflight)
							span #{translate("save")}

				.page-separator
				.d-flex.gap-3
					a.btn.btn-secondary(href='/user/mysettings') #{translate("back_to_account_settings")}
					a.btn.btn-secondary(href='/project') #{translate("back_to_your_projects")}
