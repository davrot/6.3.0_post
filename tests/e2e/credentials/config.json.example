{
  "_readme": [
    "LOCAL-ONLY external-service credentials for the e2e suite.",
    "1) cp config.json.example config.json   2) fill in   3) leave it on THIS machine (config.json is git-ignored).",
    "Set \"enabled\": true per service to activate its probe in specs/external-probe.test.e2e.ts.",
    "Services that issue ONLY short-lived keys after a one-time login (e.g. Dropbox OAuth):",
    "   do NOT paste the ephemeral key here — run `node scripts/auth-capture.mjs --service <name>`",
    "   (one-time browser login) and the token is cached in credentials/.auth/ with expiry.",
    "   Or, if the service has STABLE credentials (user+pass/PAT), put those here and let",
    "   the suite mint a fresh token per run. See README.md for the policy."
  ],

  "github": {
    "enabled": false,
    "api": "github",
    "baseUrl": "https://github.com",
    "username": "",
    "pat": ""
  },

  "forgejo": {
    "enabled": false,
    "api": "gitea",
    "baseUrl": "https://codeberg.org",
    "username": "",
    "pat": ""
  },

  "gitea": {
    "enabled": false,
    "api": "gitea",
    "baseUrl": "https://codeberg.org",
    "username": "",
    "pat": ""
  },

  "gitlab": {
    "enabled": false,
    "api": "gitlab",
    "baseUrl": "https://gitlab.com",
    "username": "",
    "pat": ""
  },

  "webdav": {
    "enabled": false,
    "baseUrl": "https://cloud.example.com/remote.php/dav/files/user",
    "username": "",
    "password": ""
  },

  "dropbox": {
    "enabled": false,
    "username": "",
    "_note": "OAuth service with short-lived tokens: obtain via `node scripts/auth-capture.mjs --service dropbox --url <authorize-url>`; cached in .auth/dropbox.json — do not hand-paste",
    "appFolder": "",
    "token": "",
    "tokenExpiresAt": ""
  },

  "zotero": {
    "enabled": false,
    "baseUrl": "https://www.zotero.org",
    "username": "",
    "userId": "",
    "apiKey": ""
  },

  "llm": {
    "enabled": false,
    "_note": "OpenAI-compatible endpoint (baseUrl + /models + /chat/completions)",
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "",
    "model": "gpt-4o-mini"
  }
}
